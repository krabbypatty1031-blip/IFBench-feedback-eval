# IFBench Configuration
# Copy to .env and fill in your values

# API Configuration
API_BASE=https://some-openai-compatible-endpoint/v1
API_KEY=your-api-key-here
# Task 6 needs two candidates. MODEL is used as model_a when MODEL_A is unset.
MODEL=Qwen/Qwen3-VL-30B-A3B-Thinking-FP8
MODEL_A=Qwen/Qwen3-VL-30B-A3B-Thinking-FP8
MODEL_B=Qwen/Qwen3-8B
# HKBU GenAI is Azure-shaped, not OpenAI /v1 + Bearer. To use it later:
# API_PROVIDER=azure
# API_BASE=https://genai.hkbu.edu.hk/general/rest
# API_KEY=your-hkbu-genai-key
# MODEL_A=gpt-4.1
# MODEL_B=gpt-4o
# Optional: AZURE_OPENAI_API_VERSION=2024-02-01
# HKBU has no /user/balance; do not invent a zero wallet.
# Required for paid development trial:
# FEEDBACK_EVAL_AUTHORIZE_SPEND=1
# Optional hard stop (default comes from development.yaml trial.call_limit):
# FEEDBACK_EVAL_DEV_CALL_LIMIT=16

# Generation Parameters
TEMPERATURE=0.6
MAX_TOKENS=8192
SEED=42

# Benchmark Parameters
INPUT_FILE=data/IFBench_test.jsonl
OUTPUT_FILE=data/responses.jsonl
WORKERS=8
